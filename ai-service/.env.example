# Ollama adalah provider default. OpenRouter tetap tersedia jika dipilih eksplisit.
LLM_PROVIDER=ollama
# URL ini harus dapat dijangkau dari proses AI service.
# Jika AI service berjalan di container, gunakan alamat host Ollama yang terlihat dari container.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
# --- OpenRouter (diabaikan saat LLM_PROVIDER=ollama) ---
# Get a key at https://openrouter.ai/keys. Never commit the real value.
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY
# Primary model slug, e.g. vendor/name:free. Full list: https://openrouter.ai/models
OPENROUTER_MODEL=REPLACE_WITH_MODEL_SLUG
# Optional comma-separated fallback slugs, tried in order. Keep all :free to stay free.
OPENROUTER_FALLBACKS=
OPENROUTER_MAX_TOKENS=8192
# Matikan reasoning agar max_tokens tidak habis dimakan thinking
# (opsi: max/xhigh/high/medium/low/minimal/none).
OPENROUTER_REASONING_EFFORT=none
# Opsional: pin provider yang terbukti stabil (slug lowercase, csv).
# Tanpa ini OpenRouter load-balance dan kadang mendarat di endpoint rusak.
# Daftar endpoint: GET /api/v1/models/<slug>/endpoints
OPENROUTER_PROVIDER_ORDER=
LLM_TIMEOUT_SECONDS=120
# Generate a random value of at least 32 characters; use the same value in backend/.env.
AI_SERVICE_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
