# Copy to .env and use your own key and exact selected Nemotron model ID.
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=REPLACE_WITH_YOUR_NVIDIA_NEMOTRON_MODEL_ID_ENDING_IN_FREE
# prompt: schema in prompt + local JSON validation.
# json_schema: only when the model/provider supports structured outputs.
OPENROUTER_RESPONSE_FORMAT=prompt
OPENROUTER_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
# Same internal key as backend/.env; NOT the OpenRouter API key.
AI_SERVICE_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
