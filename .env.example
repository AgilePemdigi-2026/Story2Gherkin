# Local development only. Copy to .env if it does not exist.
# Most fields below are the planned Sprint 1 contract; health stubs do not consume them yet.
APP_ENV=development
BACKEND_ADDR=127.0.0.1:8080
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=

# Native database: port 5432. Optional Compose database: port 5433.
# Fill DATABASE_URL with an application-role connection string, not a superuser.
DATABASE_URL=
POSTGRES_DB=story2gherkin_dev
POSTGRES_USER=s2g_dev_admin
POSTGRES_PASSWORD=

# Proposed opaque-session implementation; secure cookies mandatory on production HTTPS.
SESSION_COOKIE_NAME=s2g_session
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
PASSWORD_RESET_TTL_SECONDS=900

# Local Mailpit only; no external messages are sent by the starter.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@story2gherkin.test
SMTP_USERNAME=
SMTP_PASSWORD=

# Fill only after the team has selected and tested the open-source model/provider.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_REPAIR_MAX_ATTEMPTS=3
GENERATE_TOTAL_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENCY=2
GENERATE_RATE_LIMIT_PER_MIN=10
PROMPT_VERSION=v1
